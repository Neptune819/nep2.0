{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python .code/build_vercel.py",
  "regions": ["sin1"],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{.code/**,docs/**,scripts/**,*.docx,*.bat,PROGRESS.md}"
    }
  }
}
